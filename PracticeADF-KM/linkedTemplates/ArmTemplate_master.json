{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "PracticeADF-KM"
		},
		"AzureDataLakeStorage_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage_ls'"
		},
		"ls_sqlDB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sqlDB'"
		},
		"AthleteHttpLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/darshilparmar/tokyo-olympic-azure-data-engineering-project/raw/refs/heads/main/data/Athletes.csv"
		},
		"AzureDataLakeStorage_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlspracticekbmstorage.dfs.core.windows.net/"
		},
		"ls_sqlDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "carsales-server1.database.windows.net"
		},
		"ls_sqlDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "CarSales-SQL"
		},
		"ls_sqlDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminkavita"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "PracticeADF-KM_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage_ls_accountKey": {
						"value": "[parameters('AzureDataLakeStorage_ls_accountKey')]"
					},
					"ls_sqlDB_password": {
						"value": "[parameters('ls_sqlDB_password')]"
					},
					"AthleteHttpLS_properties_typeProperties_url": {
						"value": "[parameters('AthleteHttpLS_properties_typeProperties_url')]"
					},
					"AzureDataLakeStorage_ls_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage_ls_properties_typeProperties_url')]"
					},
					"ls_sqlDB_properties_typeProperties_server": {
						"value": "[parameters('ls_sqlDB_properties_typeProperties_server')]"
					},
					"ls_sqlDB_properties_typeProperties_database": {
						"value": "[parameters('ls_sqlDB_properties_typeProperties_database')]"
					},
					"ls_sqlDB_properties_typeProperties_userName": {
						"value": "[parameters('ls_sqlDB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}